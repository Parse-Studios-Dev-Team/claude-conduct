{
  "name": "claude-conduct",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Ambient background music that scales with Claude Code session complexity (token/context usage + model tier).",
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p playground",
    "build": "esbuild bin/conduct-hook.ts bin/conduct-daemon.ts bin/conduct.ts --bundle --platform=node --format=esm --packages=external --outdir=dist --out-extension:.js=.mjs",
    "conduct": "tsx bin/conduct.ts",
    "daemon": "tsx bin/conduct-daemon.ts",
    "demo": "tsx scripts/demo.ts",
    "setup": "npm run build && npm run install-hooks",
    "install-hooks": "tsx scripts/install-hooks.ts",
    "export-stems": "tsx scripts/export-stems.ts",
    "render-session": "tsx scripts/render-session.ts",
    "playground": "tsx scripts/playground.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "optionalDependencies": {
    "speaker": "^0.5.5"
  }
}
